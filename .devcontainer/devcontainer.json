// A ready-to-code environment for VS Code ("Reopen in Container") and GitHub Codespaces: Python 3.12 with uv,
// Node 24 with pnpm, the dependencies installed and the UI built. Then `uv run design-pipeline` and open port 8000.
{
	"name": "MAF example: design pipeline",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/node:1": { "version": "24" }
	},

	"containerEnv": {
		// The Python environment lives outside the workspace, so it never clashes with a .venv made on the host
		// (on Windows or macOS that one holds binaries this Linux container can't run).
		"UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
		"UV_LINK_MODE": "copy",
		"COREPACK_ENABLE_DOWNLOAD_PROMPT": "0",
		// pnpm keeps its package store on the same disk as node_modules, which (being a volume, see below) would
		// put it in the workspace as .pnpm-store/. Keep it in the home folder instead.
		"pnpm_config_store_dir": "/home/vscode/.local/share/pnpm/store",
		// Reachable through the forwarded port, not only from inside the container.
		"PIPELINE_HOST": "0.0.0.0"
	},
	// Same reason for web/node_modules: a volume of its own instead of the host's folder. It also makes installs
	// much faster than a bind mount on Windows and macOS.
	"mounts": [
		"source=maf-example-node-modules,target=${containerWorkspaceFolder}/web/node_modules,type=volume"
	],

	"postCreateCommand": "bash .devcontainer/post-create.sh",

	"forwardPorts": [8000, 5173],
	"portsAttributes": {
		"8000": { "label": "Design pipeline (app + API)", "onAutoForward": "openBrowser" },
		"5173": { "label": "Vite dev server (UI with hot reload)", "onAutoForward": "notify" }
	},

	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python", "charliermarsh.ruff", "svelte.svelte-vscode"],
			"settings": {
				"python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
				"python.testing.pytestEnabled": true,
				"[python]": { "editor.defaultFormatter": "charliermarsh.ruff" }
			}
		}
	},

	"remoteUser": "vscode"
}
