# Copy to .env (git-ignored) and change what you need. Every value here is the default.
# Environment variables of the same name win over this file.

# --- The model --------------------------------------------------------------------------------------------------
# mock | openai | azure-openai | openai-compatible
#   mock               offline, scripted: the agents, tools and workflow all run for real, only the words are canned
#   openai             api.openai.com (needs PIPELINE_API_KEY, or OPENAI_API_KEY)
#   azure-openai       Azure OpenAI / Foundry through its OpenAI-compatible v1 endpoint (needs ENDPOINT and API_KEY)
#   openai-compatible  anything that speaks Chat Completions: Ollama, vLLM, LM Studio, a gateway (needs ENDPOINT)
PIPELINE_PROVIDER=mock
PIPELINE_MODEL=gpt-4.1-mini
# PIPELINE_API_KEY=
# PIPELINE_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
# PIPELINE_ENDPOINT=http://localhost:11434/v1/
# Per-agent model overrides: the developer is where a stronger model pays for itself.
# PIPELINE_MODEL_DEVELOPER=gpt-4.1
# PIPELINE_MODEL_INTERVIEWER=
# PIPELINE_MODEL_TESTER=
# PIPELINE_MODEL_MERGE_REQUEST=

# --- Defaults for the start form ----------------------------------------------------------------------------------
PIPELINE_MAX_QUESTIONS=6
PIPELINE_MAX_REVIEW_ROUNDS=2
PIPELINE_WORK_ITEM_KEY=DEMO-123

# --- The server -------------------------------------------------------------------------------------------------
PIPELINE_HOST=127.0.0.1
PIPELINE_PORT=8000
# Where run folders go (relative to this folder, or absolute).
PIPELINE_OUTPUT_ROOT=output
# How long the scripted model "thinks", in seconds. 0 makes offline runs instant.
PIPELINE_MOCK_DELAY=0.35

# --- Integrations (mocked by default) ---------------------------------------------------------------------------
# Jira Cloud and Confluence Cloud: set USE_MOCK=false plus a base URL, email and API token to call them for real.
PIPELINE_JIRA_USE_MOCK=true
# PIPELINE_JIRA_BASE_URL=https://your-org.atlassian.net
# PIPELINE_JIRA_EMAIL=you@example.com
# PIPELINE_JIRA_API_TOKEN=
PIPELINE_CONFLUENCE_USE_MOCK=true
# PIPELINE_CONFLUENCE_BASE_URL=https://your-org.atlassian.net
# PIPELINE_CONFLUENCE_EMAIL=you@example.com
# PIPELINE_CONFLUENCE_API_TOKEN=
# PIPELINE_CONFLUENCE_PAGE_ID=123456

# GitHub: the release agent's create_pull_request tool. With GITHUB_MCP=true and a token it comes from GitHub's
# MCP server (a fine-grained PAT with pull-request write on the repo); otherwise a local stand-in answers.
PIPELINE_GITHUB_OWNER=your-org
PIPELINE_GITHUB_REPO=your-repo
PIPELINE_GITHUB_MCP=false
# PIPELINE_GITHUB_TOKEN=
